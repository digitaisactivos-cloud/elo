# OBRIGATÓRIO — a app guarda tudo no Supabase (sem estas vars mostra o ecrã de configuração)
# Dashboard Supabase -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 1) Cria o projeto em supabase.com (grátis)
# 2) SQL Editor -> New query -> cola o conteúdo de supabase-schema.sql -> Run
# 3) Copia este ficheiro para .env.local e preenche (nunca commits .env.local)
# 4) Na Vercel: Settings -> Environment Variables -> adiciona as 2 vars -> Redeploy
